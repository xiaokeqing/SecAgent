# ============================================================
# 构建上下文排除清单
# 目的：镜像里不要混入构建产物、开发环境配置与内部资料
# ============================================================

# ---------- 构建产物 ----------
target/
build/
dist/

# ---------- 版本控制与 IDE ----------
.git/
.gitignore
.gitattributes
.idea/
.vscode/
*.iml

# ---------- 内部资料（不对外） ----------
docs/internal/

# ---------- 运行时数据 ----------
# data/ 与 uploads/ 都由 docker-compose 挂载卷提供，
# 不打进镜像，避免把本地调试数据带到生产。
data/
uploads/
logs/
*.log

# ---------- 敏感信息 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 文档与杂项 ----------
*.md
!README.md
docs/
*.zip
*.pdf
