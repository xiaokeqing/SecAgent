# ============================================================
# SecAgent 环境变量模板
# ------------------------------------------------------------
# 用法：cp .env.example .env   然后填入真实值
# .env 已被 .gitignore 屏蔽，绝不会进入版本库。
#
# 生成强随机值（Linux / macOS / Git Bash）：openssl rand -base64 24
# PowerShell：[Convert]::ToBase64String((1..24 | % { Get-Random -Max 256 }))
#
# ⚠️ 本文件是【模板】：所有敏感项一律留空，不要在这里填真实值。
#    否则会被 CI 的 gitleaks 密钥扫描拦下（这是有意设计的门禁）。
# ============================================================

# ---------- 必填 1：阿里云百炼 API Key（申请地址 https://bailian.console.aliyun.com/ ）----------
# 【仍然必填】即使对话切到 DeepSeek：DeepSeek 没有 embedding API，
# 向量检索（text-embedding-v4）与知识库重建一直走这里。详见 RUNBOOK §28。
DASHSCOPE_API_KEY=

# ============================================================
# 对话模型供应商（DashScope ⇄ DeepSeek，详见 RUNBOOK §28）
# ------------------------------------------------------------
# 【默认保持现状】APP_LLM_PROVIDER 留空/dashscope = 改造前口径（qwen-plus）。
# 想用 DeepSeek 就把 DEEPSEEK_API_KEY 填上、并把 APP_LLM_PROVIDER 改成 deepseek，
# 然后【按发布链重建容器】（★不要 docker compose up 手工重建 —— 会丢 digest 引用）。
#
# ⚠️ 对话可换、向量不可换：DeepSeek 没有 embedding API，
#    DASHSCOPE_API_KEY 不能撤，向量那条路始终是 DashScope。
# ⚠️ 只写这两个变量的取值以外的东西（例如 deepsek 拼错）会【明确失败】，不会静默回落 ——
#    静默回落会让"以为切了、其实没切"，而页面上的 generatedBy 如实写着实际那家，对不上。
# ⚠️ 切完务必核对启动日志里那一行 LLM-PROVIDER-SELFCHECK（选中的供应商/模型名/Key 状态），
#    不要只看配置文件："配置改了但 Bean 没拿到"不会报任何错。
# ============================================================

# 对话模型供应商：dashscope（默认，保持现状）| deepseek。
APP_LLM_PROVIDER=dashscope

# 【显式开关，默认空=关闭】主供应商不可用时是否尝试备用（取值同样是 dashscope|deepseek）。
# 关闭时语义最简单：模型不可用 → 上层如实判「未生成」（fail-closed），不换人。
# 开启时回答里的 generatedBy 会【如实改成真正生成的那家】，绝不悄悄换一家还署原名。
# 注意：配额用尽（评测/公开/用户三本账）【不触发】回退 —— 换供应商不能把额度绕过。
APP_LLM_FALLBACK_PROVIDER=

# DeepSeek Key（对话框切到 deepseek 时必填；留空 = 该供应商不可用并在启动自检里显式打印 MISSING）。
# 只从环境变量读，绝不写进仓库/文档/测试。申请地址 https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# DeepSeek 可选覆盖（默认值就是下面这些，一般不用写）：
# 模型名：deepseek-chat（通用对话）。deepseek-reasoner 目前【未验证支持】——
#   它会在响应里多一个 reasoning_content 字段，且对"只输出 JSON"的约束不敏感，详见 RUNBOOK §28。
APP_LLM_DEEPSEEK_MODEL=deepseek-chat
# 接口地址（OpenAI 兼容）。
APP_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 出站超时（毫秒）：默认继承 app.outbound.*（3s/12s/15s），且【只允许收紧】——
# 配置超过上限会被夹回上限。放大它不会更宽容，只会让入口（25s/20s）先被拖死。
# APP_LLM_DEEPSEEK_CONNECT_TIMEOUT_MS=
# APP_LLM_DEEPSEEK_READ_TIMEOUT_MS=
# APP_LLM_DEEPSEEK_CALL_TIMEOUT_MS=

# ---------- 必填 2：登录凭据（要求 12 位以上，不要用默认弱口令）----------
SECAGENT_USERNAME=admin
SECAGENT_PASSWORD=
SECAGENT_ANALYST_USERNAME=analyst
SECAGENT_ANALYST_PASSWORD=
# 系统级 API Token（服务到服务调用，持有者等同管理员）
SECAGENT_API_TOKEN=

# ---------- 安全开关 ----------
# true  = 对外部署：检测到默认/弱口令直接拒绝启动（推荐）
# false = 本地开发：仅打印告警，保持开箱即用
SECAGENT_STRICT_CREDENTIALS=true

# ---------- 首次部署 ----------
# true  = 启动时构建/重建安全知识库（调用 Embedding API，产生少量费用）
# false = 使用 data/vector-store.json 中已有的向量
VECTOR_KB_AUTO_INDEX=false

# ---------- 模型调用额度上限（生产值）----------
# 用户池：你自己使用；评测池：跑评测卷子；公开池：对外演示端点
APP_QUOTA_DAILY_LIMIT=50
APP_QUOTA_EVAL_DAILY_LIMIT=60
APP_QUOTA_PUBLIC_DAILY_LIMIT=30

# ============================================================
# 混合检索（RAG 两路召回 + RRF + 轻量重排，详见 RUNBOOK §25）
# ------------------------------------------------------------
# 全部可以留空：留空 = 用代码默认值（下面注释里的值就是默认值，也是线上生效值）。
# 想改哪个就把该行的值写上，并确认 docker-compose.yml 里对应的
# APP_RAG_* 透传行也在（compose 的 environment 段不透传的话，写在这里不会生效，
# 而且不会报错 —— 这个坑在 APP_QUOTA_* 上已经踩过一次）。
#
# ★ 回退到"改造前的纯稠密口径"（一条配置、无需改代码与重新部署）：
#     APP_RAG_SPARSE_ENABLED=false
#     APP_RAG_RERANK_ENABLED=false
# ============================================================

# 稀疏通道（BM25）开关。true=两路召回；false=纯稠密（改造前口径）。
# 中文按字符 bigram 切、英文/数字按整词切（自实现分词器，无第三方依赖）。
APP_RAG_SPARSE_ENABLED=true

# RRF 的 k 参数：把两路的名次融合成最终分，score = Σ 1/(k+rank)。
# k 越大越平均（弱化头部名次差异），越小越激进。默认 60（与文献/Elasticsearch 同口径）。
APP_RAG_RRF_K=60

# 轻量重排开关。true=在 RRF 之后按"命中词覆盖度/标题加权/长度惩罚/字符 n-gram 重合"重排；
# false=只用 RRF 分排序（更保守，参数更少）。
# 注意：这是【词袋级统计】重排，不是 Cross-Encoder（差距与代价见 RUNBOOK §25 与交付说明）。
APP_RAG_RERANK_ENABLED=true

# 每次检索给模型的片段数。默认 3。
# 老键 rag.top-k（application.yml）仍然生效；两者同时存在时以本键为准。
APP_RAG_TOP_K=3

# 稠密通道的相似度门槛：低于它视为"知识库未命中"（走拒答/兜底）。
# 混合检索【不】改这个门槛 —— 否则会出现"检索看起来变准了，其实只是把该拒答的问题变成了硬答"。
# 对接 Milvus 且使用距离度量（越小越相关）时设为 0 关闭过滤。默认 0.30。
APP_RAG_MIN_SCORE=0.30

# ============================================================
# 通知中枢（NOTIFY_*，详见 RUNBOOK §19）
# ------------------------------------------------------------
# 通道是【通用 webhook】：Telegram Bot / 飞书 / 钉钉 / 企业微信 / Bark / 自建 n8n
# 的共同点只有「HTTP POST 一个 JSON」，所以这里只配「地址 + 载荷模板」，不写死某一家。
#
# 留空的语义：NOTIFY_WEBHOOK_URL 为空 = 通知功能关闭（事件只写审计与日志）。
# 【重要】关闭不是静默的：启动日志里 OUTBOUND-TIMEOUTS-SELFCHECK 会显式打印
#   notify-webhook{...}，其中写 "DISABLED(通知未配置:NOTIFY_WEBHOOK_URL 为空)"。
#   如果你希望手机上真能收到告警，必须自己确认那行日志里没有 DISABLED。
# ============================================================

# 目标地址。空 = 关闭。支持按事件类型分流（竖线分隔，写 TYPE=URL）：
#   默认=https://.../default|WATCHDOG_ROLLBACK=https://.../ops
# ⚠️ 很多 IM 机器人把 token 写在 URL 里 —— 那属于密钥，只能进 .env（600 权限），不要入库
NOTIFY_WEBHOOK_URL=

# 载荷模板。留空 = 通用 {"text":"{{title}}\n{{body}}"}。
# 可用变量：{{title}} {{body}} {{severity}} {{severityLabel}} {{type}} {{typeLabel}}
#           {{ip}} {{actor}} {{time}} {{count}}
# Telegram： {"chat_id":"<你的 chat_id>","text":"{{title}}\n{{body}}"}
# 飞书：     {"msg_type":"text","content":{"text":"{{title}}\n{{body}}"}}
# 钉钉：     {"msgtype":"text","text":{"content":"{{title}}\n{{body}}"}}
NOTIFY_WEBHOOK_TEMPLATE=

# 最低通知等级：INFO / LOW / MEDIUM / HIGH / CRITICAL（默认 HIGH）
# 只认英文枚举名；写错按 HIGH 处理并打 WARN（宁可少发，也不放宽）
NOTIFY_MIN_SEVERITY=HIGH

# 同类事件冷却（秒）：同一去重键在该时间内只发一次（默认 300）
NOTIFY_COOLDOWN_SECONDS=300

# 夜间静默窗口（HH:mm-HH:mm，默认 22:00-07:00）
# **只压制 INFO/MEDIUM，HIGH/CRITICAL 照发**；留空 = 不静默
NOTIFY_NIGHT_QUIET=22:00-07:00

# 同一来源 IP 的事件合并窗口（秒）：窗口内多类事件汇成一条「聚合 N 次」（默认 600）
# 0 = 关闭合并（此时只靠上面的冷却去重）
NOTIFY_SAME_IP_MERGE=600

# ============================================================
# 公开面 IP 显示口径 + "永不公开"清单（站主 2026-10-14 拍板，详见 RUNBOOK §26）
# ------------------------------------------------------------
# 【唯一开关】APP_PUBLIC_MASK_IPS 只被 PublicIpPolicy 读一次，再作用到【所有】公开端点：
#   true  = 掩码（改造前口径：45.205.***.***、内网 →「内部地址」）
#   false = ★默认，站主拍板：显示【观测到的真实来源 IP】
# 影响的端点（同一个口径来源，一个都不会漏）：
#   GET  /api/public/overview   GET  /api/public/alerts   GET  /api/public/alerts/{aggId}
#   GET  /api/public/honeypot   GET  /api/public/audit    GET  /api/public/latest
#   GET  /api/public/kb         GET  /api/public/geo      GET  /api/public/webstats
#   GET  /api/public/stories    GET  /api/public/story    （攻击故事线，见 RUNBOOK §32）
#   POST /api/public/ask        （回答里的来源 + clientIp）
# 注：/geo 与 /webstats 这两个端点【本身不给任何 IP】（设计如此），只继承同一份 ipDisclosure
#     口径声明与资产名过滤 —— 它们在表里是因为"口径字段只有一个来源"。webstats 见 RUNBOOK §29。
# 内网/保留/链路地址（10.x / 172.16-31.x / 192.168.x / 127.x / fe80:: …）在任何口径下
#   都不作为攻击源公开，一律写成「内网/未知」。
#
# ⚠️ 必须同时确认 docker-compose.yml 的 environment 段里有 APP_PUBLIC_MASK_IPS 透传行：
#    不透传时"在 .env 里加一行"不会生效，而且【不会报错】（APP_QUOTA_*/APP_RAG_* 踩过这个坑）。
# ⚠️ 本键【不要留空】：空字符串绑到 boolean 会让应用启动失败。要切回掩码就显式写 true。
# 一键切回掩码：把下面改成 true → 按发布链重建容器（不要 docker compose up 手工重建）。
# ============================================================
APP_PUBLIC_MASK_IPS=false

# ipDisclosure.removalContact 的值（"移除/更正"入口）。
# 站主按自己的实际情况改：邮箱（mailto:you@example.com）或博客关于页 URL 都行。
# 这个字段会出现在每一个公开响应里，是"被展示者"唯一的申诉入口。
APP_PUBLIC_REMOVAL_CONTACT=https://xiaokeqing.cn/about/

# ============================================================
# 离线地理富化 / 攻击来源分布（DB-IP Lite，CC BY 4.0；详见 RUNBOOK §26）
# ------------------------------------------------------------
# 零联网：只用本地库文件，不在请求路径上调任何在线地理/情报 API。
# 库文件【不进仓库、不进镜像】：放在宿主机 /opt/secagent/geoip（600/700，属主 999:999），
# 只读挂载到容器 /opt/geoip。月度更新：bash scripts/srv1-geoip-update.sh
#
# 署名（CC BY 4.0 要求，不是可选）：公开页面与 /api/public/geo 的 note 里必须带
#   "IP 地理位置数据由 DB-IP (https://db-ip.com) 提供，CC BY 4.0"
#
# ⚠️ 下面每一项都必须在 docker-compose.yml 的 environment 段里有对应透传行，
#    否则"在 .env 里加一行"不生效且不报错（APP_QUOTA_*/APP_RAG_* 踩过这个坑）。
# ============================================================

# 总开关：false = 端点如实返回 available=false/GEO_DISABLED（不会返回空分布冒充"没有攻击"）
APP_GEOIP_ENABLED=true

# 库路径。容器里必须是挂载后的路径；本机开发可以直接指向下载目录里的具体文件，
# 也可以指向一个目录（自动取最新的 dbip-city-lite-YYYY-MM.csv.gz）。
APP_GEOIP_CITY_DB=/opt/geoip/dbip-city-lite.csv.gz
APP_GEOIP_ASN_DB=/opt/geoip/dbip-asn-lite.csv.gz

# 是否加载 IPv6 区间：true（默认，完整）实测常驻约 164MB；false 省约 80MB，
# 代价是 IPv6 来源一律归为"未定位"（不上地图）。srv1 是 1.5GB 容器，默认开即可。
APP_GEOIP_IPV6_ENABLED=true

# ★ 我方公网/内网出口 IP（逗号分隔）。**不填的后果是具体的**：
#   实测 24 小时 data.srcip 排第 2 的就是 srv2 自己的公网 IP（180 条）、第 3 名 srv1（15 条）
#   —— 不排掉，"攻击来源 TOP"里会出现我们自己的服务器。
#   这些地址只进响应里的 coverage.excludedSelf 计数，永远不进国家/省份/ASN 榜。
#   留空 = 不排除任何地址（默认，因为服务器真实 IP 不进仓库）。
APP_GEOIP_SELF_IPS=

# 来源 IP 的字段名（顺序无关）。实测同一索引里两种写法并存：
#   主机侧/蜜罐 data.srcip，Suricata（经 Wazuh agent 进来）data.src_ip。
# 只查一个字段会丢掉一大半来源，而且不会报错。
APP_GEOIP_SRC_IP_FIELDS=data.srcip,data.src_ip

# 入榜门槛：count >= 3 且占比 >= 1%。两条一起卡：
#   只卡占比 → 小窗口里"1 次攻击 = 100%"照样上榜；只卡条数 → 长尾噪声占满榜单。
APP_GEOIP_MIN_COUNT=3
APP_GEOIP_MIN_SHARE_PERCENT=1.0
# 每个来源字段取多少个 IP 做聚合（terms size）；超出的长尾由响应里的
# coverage.sourceBucketsTruncated 如实披露，不会假装是完整分布。
APP_GEOIP_TOP_IPS=1000

# ============================================================
# 内部资产名停用词表（"永不公开"清单第 ② 条，详见 RUNBOOK §26）
# ------------------------------------------------------------
# 命中的词在公开响应里一律替换为「[内部标识已脱敏]」，作用面是【整棵响应树】，
# 包括 F5-B 方案 B 直出到回答正文的知识库引用片段（实测 mock 资产名就是这么漏出去的）。
# 默认值 = 实测泄露过的名字：web-01/web-02/web-03、db-01、auth.log、
#   /api/order/detail、/upload/files/
# 新增自己的内网资产名就追加在这里（逗号分隔，不分大小写，≤2 字符的词会被忽略）。
# 注意：不要加 srv1 / srv2 —— 公开端点本就用这两个 id 说明两台服务器在线状态。
# ============================================================
APP_PUBLIC_ASSET_BLOCKLIST=web-01,web-02,web-03,db-01,auth.log,/api/order/detail,/upload/files/

# ============================================================
# 应用侧访问日志（URL 级扫描/探测的可见性来源，详见 RUNBOOK §24）
# ------------------------------------------------------------
# 为什么要有它：Spring 不记未匹配路由 —— /wp-login.php、/.env、
# /../../etc/passwd 这类请求以前"返回 404 且一行都不记"，
# 主机侧的 fail2ban / Wazuh 因此对 URL 级扫描完全瞎（§21.2 第 1 条）。
#
# 落盘内容（白名单，顺序固定）：ts / method / path / queryKeys / status /
#   clientIp / ua / ms / reqId
# 绝不落盘：请求体、查询串原文、Cookie、Authorization、Referer、响应体。
#
# ⚠️ 这几个键【不要留空】：留空会变成"空字符串绑到 boolean/int"，
#    应用会直接启动失败（不是静默降级）。要关掉就显式写 false。
# ⚠️ 与 APP_QUOTA_* 不同：这里【不需要】在 docker-compose.yml 里显式透传 ——
#    compose 的 SPRING_APPLICATION_JSON 没有覆盖 app.accesslog.*，
#    所以 env_file 里的这几个键会正常生效。
# ============================================================

# 总开关。true=写访问日志（推荐；生产必须为 true，否则 fail2ban 的
# secagent-webscan 系列 jail 永远不会触发）。false 时启动日志会明写
# "ACCESSLOG DISABLED" —— 关闭是可见的，不是静默失效。
APP_ACCESSLOG_ENABLED=true

# 容器内目录。宿主上的实际路径是 /opt/secagent/data（compose 里 ./data 挂载，
# 也在 §22 的异地备份范围内）。不要把这里指到 /tmp 或 /var/log：
# 前者重启就没了，后者在容器里重建容器就没了。
APP_ACCESSLOG_DIR=data

# 切分文件保留天数（按 mtime 删；活动文件 access.jsonl 永不删）。
# 容量上限 ≈ retain-days × max-file-mb（默认 7 × 64MB = 448MB），
# 但真实量级远低于此（实测见 RUNBOOK §24）。
APP_ACCESSLOG_RETAIN_DAYS=7

# 单文件上限（MB）：超过就切分成 access-<时间戳>.jsonl（跨天也切一次）。
APP_ACCESSLOG_MAX_FILE_MB=64

# 不记录的路径：逗号分隔；以 * 结尾表示前缀匹配，其余精确匹配。
# 默认跳过 /api/health —— 容器 healthcheck 每 30 秒一次 = 一天 2880 行噪声。
APP_ACCESSLOG_SKIP_PATHS=/api/health

# ============================================================
# 公开聚合端点 GET /api/public/webstats（访问日志的只读聚合，详见 RUNBOOK §29）
# ------------------------------------------------------------
# 给博客"监测中心"画两张图：HTTP 状态码分布（只到类别）与 7 天 × 24h 热力图；
# 另给固定类别 TOP（wp-login/dotenv/dotgit/phpmyadmin/traversal/admin-panel/other-*）
# 与 UA TOP。
#
# 【口径 = 站主 2026-10-14 拍板，不许自行放宽】
#   · 只输出聚合：响应里不含任何 IP（连掩码 IP 都没有）、不含"来源数"；
#   · 路径只给固定类别枚举 —— 攻击者可控字符串永不出现在公网页面；
#   · 状态码只到类别；不公开"疑似扫描占比"（= 公开检测能力边界）；
#   · 入榜门槛：计数 >= min-count 才出现，低于门槛的只计入总量。
#
# 【怎么关】把 APP_WEBSTATS_ENABLED 显式写 false。关掉后端点会如实返回
#   available=false + reason=WEBSTATS_DISABLED（不是"空分布"——那会被渲染成"没人扫我们"）。
#
# ⚠️ 这几个键【不要留空】：留空会变成"空字符串绑到 boolean/int"，应用直接启动失败。
# ⚠️ 与 APP_QUOTA_*/APP_RAG_* 同一个坑：docker-compose.yml 的 environment 段【已显式透传】
#    下面这几个键；若只在 .env 里加一行而 compose 里没有透传行，会"不生效且不报错"。
# ============================================================

APP_WEBSTATS_ENABLED=true

# 入榜门槛（口径⑤）：类别/UA 计数小于它的只计入总量，不进榜（抗偶发噪声刷榜）。
APP_WEBSTATS_MIN_COUNT=5

# 两个榜的长度上限（类别榜 / UA 榜）。
APP_WEBSTATS_TOP_CATEGORIES=10
APP_WEBSTATS_TOP_UAS=5

# 公网 UA 截断长度：UA 是攻击者可控字符串，超过就截断；控制字符替换成空格、
# IP 形态的子串替换成 [ip]（保证响应体里零 IP 形态，有测试按正则扫描钉住）。
APP_WEBSTATS_UA_MAX_CHARS=60

# 启动回填的字节预算（MB）：启动时后台线程从 access.jsonl（+ 最近轮转文件）读最近 7 天，
# 读满预算即停；读不到的天就缺天，响应里 coverage 会如实披露（不编造）。
APP_WEBSTATS_BACKFILL_MAX_MB=64

# 日志文件状态探测间隔（秒）：文件被删/被轮转/恢复都在这个粒度内反映到 available/reason。
# 端点的 15 秒快照 + 这个探测一起决定了"探测到文件变化"的最坏延迟。
APP_WEBSTATS_FILE_PROBE_SECONDS=10

# ============================================================
# 攻击故事线 GET /api/public/stories + GET /api/public/story（详见 RUNBOOK §32）
# ------------------------------------------------------------
# 【它是什么】把【同一个来源】的「告警 → 诱饵端口 → 蜜罐登录 → 处置审计」串成一条时间线，
#   让博客能开一个"看一次攻击全过程"的页面：
#     · /api/public/stories?limit=10&window=24h —— 哪些来源值得看（按剧本完整度/严重度排序），
#       每条给 stages 四段计数、首末时间、severityMax，以及 gaps[]（哪几段【没有数据】）；
#     · /api/public/story?src=<IP>&window=24h —— 该来源的事件流（ts/stage/kind/summary/
#       severity 或 outcome）+ 每段的 coverage（查到多少条、哪些段读不到/未接入 + 原因）。
#
# 【四段的数据源不一样，别想当然】
#   · alerts / decoyPorts / honeypotLogins 来自 Wazuh indexer：rule.groups 分别是不含
#     cowrie/dionaea 的告警、dionaea（诱饵端口）、cowrie 登录规则 100101/100102；
#   · auditActions 来自应用侧处置留痕 data/response-audit.json ——【不在 indexer 里】，单独拼装。
#   某一段取不到就进 gaps[]；coverage.stageStatus 用 OK / NOT_WIRED / UNKNOWN 区分
#   "已接入但这段没数据"与"这段根本没接入"——两者必须能分开读，否则会把"没接入"当成"没发生"。
#
# 【蜜罐命令时间线】Wazuh 侧没有命令执行规则 → 响应里 commandsAvailable=false，不编造命令序列。
# 【不许编】宁可少一段，也不许编一段：取不到就写"读不到/未接入 + 原因"。
# 【候选池】内网/保留地址与我方 APP_GEOIP_SELF_IPS 不进榜（它们在公开口径里都写成「内网/未知」，
#   合并后会出现"内网/未知 打了我们 4 万次"这种误导读数）；排除数在 coverage 里如实给出。
#
# ⚠️ 这三个键【不要留空】：空字符串绑到 int 会让应用直接启动失败。
# ⚠️ 与 APP_QUOTA_*/APP_WEBSTATS_* 同一个坑：docker-compose.yml 的 environment 段【已显式透传】
#    下面这三个键；只在 .env 里加一行而 compose 没有透传行，会"不生效且不报错"。
# ============================================================

# 候选来源上限（indexer terms size）。它同时是 /story 的"可查询来源池"大小：
# 不在池里的 src 一律 404 —— 否则这个端点会变成"随便给个 IP 就能问'他有没有打过我们'"的查询器。
APP_PUBLIC_STORY_TOP_SOURCES=50

# 单个来源、单个阶段最多取回多少条事件（每段独立限量：某段刷屏不会挤掉另外两段）。
# 超过就 truncated=true，而 coverage 里给的始终是【查到了多少条】。
APP_PUBLIC_STORY_MAX_EVENTS_PER_STAGE=40

# /api/public/stories 的 limit 上限（防"limit=100000"把响应撑大）。
APP_PUBLIC_STORY_MAX_LIMIT=20

# ============================================================
# 公开端点 POST /api/public/tts（文字转语音，详见 RUNBOOK §30）
# ------------------------------------------------------------
# 给博客页面上那个 🔊 按钮用：把【站方预设的固定短语】或【刚刚生成过的回答】
# 合成成 mp3 播出来。默认【关闭】—— 站主还没给 Fish Audio 的 Key。
#
# 【为什么默认关】/api/public/tts 是匿名可达、且会真花钱的端点。Key 缺失时它
#   会如实返回 503 KEY_MISSING，但更干净的做法是 enabled=false：前端看到
#   TTS_DISABLED 就隐藏 🔊，而不是显示一个点了必报错的按钮。
#
# 【三道闸（口径）】
#   ① 只认两种输入：phraseId（服务端短语表 app.tts.phrases.*，见
#      src/main/resources/tts-phrases.yml）或 textHash（服务端"最近生成过的回答"
#      的 sha512 前 32 位）。**自由文本一律 400 TEXT_NOT_ALLOWED** ——
#      匿名端点永不接受任意文字，否则等于公开一个"任意文字转语音"的花钱接口。
#   ② 长度 ≤ APP_TTS_MAX_CHARS（默认 120 字符）。
#   ③ 每日额度：单 IP 与全局各一本账，落盘 data/tts-quota.json，重启不丢。
# 【缓存】sha256(voiceId+"\n"+text) → data/tts-cache/<hash>.mp3；命中直接返回、
#   不再调上游、也不吃每日额度；总量超 APP_TTS_MAX_CACHE_MB 时按最旧淘汰。
# 【Key 放哪】只经环境变量 APP_TTS_API_KEY 注入（写进 /opt/secagent/.env，权限 600）。
#   **绝不**写进 compose 的默认值或 yml —— 那等于把凭据放进仓库。
# 【怎么关】APP_TTS_ENABLED=false（默认）。关掉后端点如实返回 503 TTS_DISABLED，
#   前端据此隐藏 🔊。
#
# ⚠️ 与 APP_QUOTA_*/APP_WEBSTATS_* 同一个坑：docker-compose.yml 的 environment 段
#    【已显式透传】下面全部 APP_TTS_* 键；只在这里加一行而 compose 里没有透传行，
#    会"不生效且不报错"。
# ⚠️ 除 APP_TTS_API_KEY / APP_TTS_VOICE_ID 外，其余键【不要留空】：
#    空字符串绑到 boolean/int 会让应用直接启动失败。
# ============================================================

# 总开关。默认 false（隐藏 🔊）；站主拿到 Key 后改成 true 并重启容器。
APP_TTS_ENABLED=false

# Fish Audio 的音色/模型 id（请求体 reference_id）。留空 = 用上游默认音色。
# 取值来自站主在 fish.audio 上创建的语音模型页面。
APP_TTS_VOICE_ID=

# 模型档位（上游的请求头 model）：s1 / s2-pro。
APP_TTS_MODEL=s1

# 上游基地址。一般不用改（自建代理时才改）。
APP_TTS_BASE_URL=https://api.fish.audio

# 【必须是空的默认值】上游 Key 只从这里（.env，权限 600）注入。
# 空 = 明确"没配"：端点返回 503 KEY_MISSING，绝不静默变成可用。
APP_TTS_API_KEY=

# 单次合成文本长度上限（字符）。这是成本闸：匿名请求不该能合成一大段音频。
# 硬顶 600 —— 配得比它大也会被代码夹回（只许收紧，不许放大）。
APP_TTS_MAX_CHARS=120

# 每日额度：单 IP 与全局各一本账，超限返回 429 + reason
# （PER_IP_DAILY_LIMIT / GLOBAL_DAILY_LIMIT）。全局那本才是真正的成本上限
# （换 IP 也绕不过它）。
APP_TTS_PER_IP_DAILY=20
APP_TTS_GLOBAL_DAILY=500

# 音频缓存目录（内容寻址：同一个音色 + 同一段文字的字节是同一份）。
# 落在已挂载、已备份的 data 目录；命中时连上游都不调。
APP_TTS_CACHE_DIR=data/tts-cache

# 缓存目录上限（MB）；超限时按最旧淘汰。0 或负数会取默认值 64（不会变成"不限"）。
APP_TTS_MAX_CACHE_MB=64

# 每日额度落盘文件（重启不丢）。与缓存同目录，便于一起备份。
APP_TTS_QUOTA_FILE=data/tts-quota.json

# "最近生成过的回答"的进程内 LRU 容量：textHash 闸只认这里面的回答。
# 重启即空（刻意不落盘：落盘等于把用户可见的回答原文写进磁盘）。
APP_TTS_HISTORY_SIZE=200

# 服务端短语表位置（classpath: 或 file:）。键的路径就是 app.tts.phrases.*。
APP_TTS_PHRASES_FILE=classpath:tts-phrases.yml

