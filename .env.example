# ============================================================
# SecAgent 环境变量模板
# ------------------------------------------------------------
# 用法：cp .env.example .env  然后填入真实值。
# .env 已被 .gitignore 屏蔽，绝不会进入版本库。
#
# 🔑 生成强随机值（Linux/macOS/Git Bash）：
#      openssl rand -base64 24
#    或 PowerShell：
#      [Convert]::ToBase64String((1..24 | % { Get-Random -Max 256 }))
# ============================================================

# ---------- 必填 1：阿里云百炼 API Key ----------
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-在此填入你的Key

# ---------- 必填 2：登录凭据 ----------
# 要求 12 位以上，且不要使用 admin123 / secagent-demo-token 这类默认值，
# 否则在 SECAGENT_STRICT_CREDENTIALS=true 时会直接拒绝启动。
SECAGENT_USERNAME=admin
SECAGENT_PASSWORD=在此填入强密码

SECAGENT_ANALYST_USERNAME=analyst
SECAGENT_ANALYST_PASSWORD=在此填入强密码

# 系统级 API Token（用于服务到服务调用，持有者等同管理员）
SECAGENT_API_TOKEN=在此填入强随机Token

# ---------- 安全开关 ----------
# true  = 对外部署：检测到默认/弱口令直接拒绝启动（推荐）
# false = 本地开发：仅打印告警，保持开箱即用
SECAGENT_STRICT_CREDENTIALS=true

# ---------- 首次部署用 ----------
# true  = 启动时构建/重建安全知识库（调用 Embedding API，产生少量费用）
# false = 使用 data/vector-store.json 中已有的向量
VECTOR_KB_AUTO_INDEX=false

# ---------- 对外 Demo 的额度与限流 ----------
# 公网 Demo 务必调低，防止被刷爆配额产生账单
DAILY_QUOTA=50
RATE_LIMIT_PER_MINUTE=30

# 允许跨域的来源：填你的博客域名，多个用逗号分隔。
# 不要使用 * ；本地调试可保留 localhost。
CORS_ALLOWED_ORIGINS=http://localhost:9900

# ---------- 自有资产白名单（建议填）----------
# ResponseGuard 在执行封禁前会校验目标。内置保护网段覆盖了：
#   环回 / RFC1918 私网 / 链路本地(169.254/16) / 运营商级NAT(100.64/10) / 特殊用途段
# 其中 100.64.0.0/10 尤其重要 —— 阿里云元数据 100.100.100.200 就在这个段里，
# 封掉它会直接打断实例读取元数据与临时凭据。
#
# 但上面这些是「通用规则」，挡不住「你自己的公网资产」。把本机公网 IP、
# 域名解析出的地址、第二台服务器封了，同样是自我 DoS。所以必须显式声明：
#
#   SECAGENT_SELF_ASSETS=47.96.106.187,203.0.113.10,198.51.100.0/24
#
# 逗号分隔，支持单个 IP 与 CIDR。留空时应用会在启动日志里打告警提醒。
# 【迁移服务器时记得改这里】否则新机器自己的 IP 是能被封的。
SECAGENT_SELF_ASSETS=