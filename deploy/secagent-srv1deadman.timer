# ============================================================
# srv1 dead man switch 定时器（装在 srv2 上）
# ------------------------------------------------------------
# 每 3 分钟跑一次。为什么是 3 分钟：
#   · 云主机故障通常是"整台没了"，不是抖动 —— 不需要秒级反应
#   · 配合"连续 3 次失败"≈9 分钟，既能压掉单次网络抖动，
#     又不至于让一次真实宕机沉默半小时
# 幂等与防抖都在脚本里（连续计数的状态文件 + 冷却/重提醒），频繁运行无副作用。
# ============================================================
[Unit]
Description=每 3 分钟运行 srv1 dead man switch（在 srv2 上）

[Timer]
OnBootSec=2min
OnUnitActiveSec=3min
AccuracySec=15s
Unit=secagent-srv1deadman.service

[Install]
WantedBy=timers.target
