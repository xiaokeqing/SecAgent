# ============================================================
# SecAgent 容器守卫定时器
# ------------------------------------------------------------
# 每 25 秒跑一次（落在任务要求的 20–30 秒区间内）；开机 1 分钟后开始。
# 为什么是 25 秒：
#   · 要抓住"误删容器导致 25–30 秒停机"这种窗口，采样周期必须短于它 ——
#     配合"连续 2 次失败"，最坏检出时间 ≈ 2×25 + 脚本耗时 ≈ ≤60 秒
#   · 不能再快：每轮只是一次 docker inspect，25 秒已足够灵敏，
#     再密只会增加无谓唤醒（容器"起停抖动"也会更容易被连击）
# AccuracySec=1s 是必须的：systemd 默认 AccuracySec=1min，会把 25 秒周期
#   合并成 ~1 分钟，等于把灵敏度打回原来的盲区。
# 幂等与去抖都在脚本里（计数状态文件 + 600s 冷却 + 部署窗口抑制）。
# ============================================================
[Unit]
Description=每 25 秒运行 SecAgent 容器守卫

[Timer]
OnBootSec=1min
OnUnitActiveSec=25s
AccuracySec=1s
Unit=secagent-containerguard.service

[Install]
WantedBy=timers.target
