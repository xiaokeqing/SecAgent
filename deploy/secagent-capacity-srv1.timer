# ============================================================
# 容量/水位告警定时器（装在 srv1）
# ------------------------------------------------------------
# 每 15 分钟跑一次：
#   · 磁盘不是秒级问题，但 15 分钟的检测延迟足够"提前几天"发现趋势
#   · 真正的防刷屏在 notify.sh 的冷却键上（磁盘类默认 6 小时一次），
#     所以这里跑得勤一点没有代价，反而能让水位曲线更连续
# ============================================================
[Unit]
Description=每 15 分钟运行容量与水位体检（srv1）

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
AccuracySec=1min
Unit=secagent-capacity-srv1.service

[Install]
WantedBy=timers.target
