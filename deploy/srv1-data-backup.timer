# ============================================================
# SecAgent 状态异地备份定时器（srv1）
# ------------------------------------------------------------
# 每天 03:30 跑一次。
#   · 为什么是 03:30：避开 03:20 的评测 cron（/etc/cron.d/secagent-eval），
#     备份本身很轻（5MB），错开 10 分钟足够。
#   · Persistent=true：机器重启/关机错过窗口后，开机补跑一次。
#     备份不像部署 —— 迟到总比没有好。
#   · 这只是"最低保证"：真正的写入型变更（封禁名单/审计/额度）之后，
#     应该手动触发一次：systemctl start secagent-data-backup.service
# 查看：
#   systemctl list-timers srv1-data-backup.timer
#   journalctl -u srv1-data-backup.service -n 60 --no-pager
# ============================================================
[Unit]
Description=每天 03:30 执行 SecAgent 状态异地备份

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
AccuracySec=5min
Unit=srv1-data-backup.service

[Install]
WantedBy=timers.target
