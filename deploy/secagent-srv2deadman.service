# ============================================================
# srv2 dead man switch（装在 srv1 上）
# ------------------------------------------------------------
# 触发者：deploy/secagent-srv2deadman.timer（每 3 分钟）
# 做什么：跑 scripts/srv1-watch-srv2.sh —— 用一把【只能读心跳】的强制命令钥匙
#         连 srv2，核对 ① SSH+心跳 ② 关键容器（含 suricata）③ 备份新鲜度与解密密钥。
#         连续 3 次失败（≈9 分钟）→ notify.sh HIGH；恢复 → INFO。
#
# 为什么需要它（与 srv2 上那份 secagent-srv1deadman 对称）：
#   原来只有 srv2 盯 srv1，方向是单向的。srv2 是检测/索引器 + 异地备份的接收端，
#   它挂了：Wazuh 告警、备份落盘、备份抽测全部静默停止，而 srv1 看起来一切正常。
#
# 安装（root，srv1）：
#   install -m 644 deploy/secagent-srv2deadman.service deploy/secagent-srv2deadman.timer /etc/systemd/system/ \
#     && install -m 755 scripts/srv1-watch-srv2.sh /opt/secagent/scripts/srv1-watch-srv2.sh \
#     && systemctl daemon-reload && systemctl enable --now secagent-srv2deadman.timer
# 查看/手工跑：
#   systemctl list-timers secagent-srv2deadman.timer
#   journalctl -u secagent-srv2deadman.service -n 50 --no-pager
#   bash /opt/secagent/scripts/srv1-watch-srv2.sh --status
#   bash /opt/secagent/scripts/srv1-watch-srv2.sh --self-test
# 临时关闭：
#   systemctl disable --now secagent-srv2deadman.timer
# ============================================================
[Unit]
Description=SecAgent srv2 反向探活（dead man switch：连续 3 次失败告警）
Documentation=file:/opt/secagent/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/secagent
ExecStart=/bin/bash /opt/secagent/scripts/srv1-watch-srv2.sh
# 一轮只做一次 ssh + 若干解析，给足超时即可
TimeoutStartSec=120
Nice=10
MemoryMax=100M
CPUQuota=20%
# 私钥放在 /etc/secagent/heartbeat（不是 /root/.ssh），所以 ProtectHome=yes 不影响它 ——
# 这与 srv2 上 secagent-srv1deadman.service 的取舍一致。
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
